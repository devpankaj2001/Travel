# ==============================================================================
# ENTERPRISE BOOKING PLATFORM — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=5000
APP_NAME="Enterprise Booking Platform API"
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=booking_platform
DB_CONNECTION_LIMIT=20
DB_SSL=false

# Security & Authentication (JWT)
JWT_SECRET=booking_platform_default_jwt_secret_dev_key_2026_super_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=booking_platform_default_refresh_secret_dev_key_2026_super_secure
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

# File Uploads & Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,webp
STORAGE_TYPE=local

# Transactional Email (SMTP / Mock for Development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Booking Platform"
SMTP_FROM_EMAIL=no-reply@bookingplatform.com
MAIL_FALLBACK_TO_LOG=true

# SMS & OTP Verification (Mock logs OTP to server console)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=BOOKIN
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Business Defaults
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=India
DEFAULT_PAYMENT_GATEWAY=razorpay
