# ==============================================================================
# ENTERPRISE BOOKING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS BEFORE RUNNING
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_NAME="Enterprise Booking Platform API"
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="https://yourdomain.com,https://admin.yourdomain.com,https://supplier.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8+ / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_strong_password
DB_NAME=booking_platform
DB_CONNECTION_LIMIT=20
DB_SSL=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_strong_jwt_access_secret_min_32_characters
JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. RATE LIMITING (DDoS & Brute Force Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=25

# ------------------------------------------------------------------------------
# 5. FILE UPLOADS & STORAGE
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="pdf,jpg,jpeg,png,webp"
STORAGE_TYPE=local

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM_NAME="Booking Platform"
SMTP_FROM_EMAIL="support@yourdomain.com"
MAIL_FALLBACK_TO_LOG=false

# ------------------------------------------------------------------------------
# 7. SMS & OTP VERIFICATION
# ------------------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=BOOKIN
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 8. BUSINESS DEFAULTS & LOCALIZATION
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=India
DEFAULT_PAYMENT_GATEWAY=razorpay

# ------------------------------------------------------------------------------
# 9. INITIAL DATABASE SEED CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPasswordImmediately123!
ADMIN_DEFAULT_FIRSTNAME=Super
ADMIN_DEFAULT_LASTNAME=Admin
SEED_DEMO_DATA=false
